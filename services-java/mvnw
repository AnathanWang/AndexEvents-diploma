#!/bin/sh
# Maven Wrapper script

set -euf

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
PROPS_FILE="$WRAPPER_DIR/maven-wrapper.properties"
JAR_FILE="$WRAPPER_DIR/maven-wrapper.jar"

if [ ! -f "$PROPS_FILE" ]; then
  echo "Missing $PROPS_FILE" >&2
  exit 1
fi

if [ ! -f "$JAR_FILE" ]; then
  WRAPPER_URL=$(grep -E '^wrapperUrl=' "$PROPS_FILE" | sed -e 's/^wrapperUrl=//')
  if [ -z "${WRAPPER_URL:-}" ]; then
    echo "wrapperUrl not set in $PROPS_FILE" >&2
    exit 1
  fi
  echo "Downloading Maven Wrapper JAR..." >&2
  mkdir -p "$WRAPPER_DIR"
  if command -v curl >/dev/null 2>&1; then
    curl -sSL -o "$JAR_FILE" "$WRAPPER_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$JAR_FILE" "$WRAPPER_URL"
  else
    echo "Neither curl nor wget found; cannot download Maven Wrapper" >&2
    exit 1
  fi
fi

JAVA_CMD=${JAVA_HOME:+"$JAVA_HOME/bin/java"}
JAVA_CMD=${JAVA_CMD:-java}

exec "$JAVA_CMD" -classpath "$JAR_FILE" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
