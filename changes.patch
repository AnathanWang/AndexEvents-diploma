+  static String _initialsFrom(String name) {
+    final parts = name
+        .trim()
+        .split(RegExp(r'\s+'))
+        .where((p) => p.isNotEmpty)
+        .toList();
+    if (parts.isEmpty) return '??';
+    return parts.take(2).map((p) => p[0]).join().toUpperCase();
+  }
 
