+## 9. Деплой и инфраструктура
+
+### Docker Compose (Production)
+
+```yaml
+version: '3.8'
+
+services:
+  traefik:
+    image: traefik:v3.0
+    ports:
+      - "80:80"
+      - "443:443"
+    volumes:
+      - /var/run/docker.sock:/var/run/docker.sock:ro
+      - ./traefik:/etc/traefik
+
+  auth-service:
+    build: ./services/auth-service
+    environment:
+      - DATABASE_URL=${DATABASE_URL}
+      - FIREBASE_CREDENTIALS=${FIREBASE_CREDENTIALS}
+    labels:
+      - "traefik.http.routers.auth.rule=PathPrefix(`/api/auth`) || PathPrefix(`/api/users`)"
+
+  events-service:
+    build: ./services/events-service
+    environment:
+      - DATABASE_URL=${DATABASE_URL}
+    labels:
+      - "traefik.http.routers.events.rule=PathPrefix(`/api/events`)"
+
+  match-service:
+    build: ./services/match-service
+    environment:
+      - DATABASE_URL=${DATABASE_URL}
+      - FIREBASE_CREDENTIALS=${FIREBASE_CREDENTIALS}
+    labels:
+      - "traefik.http.routers.match.rule=PathPrefix(`/api/matches`) || PathPrefix(`/api/friends`)"
+
+  upload-service:
+    build: ./services/upload-service
+    environment:
+      - MINIO_ENDPOINT=${MINIO_ENDPOINT}
+      - MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
+      - MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
+    labels:
+      - "traefik.http.routers.upload.rule=PathPrefix(`/api/upload`)"
+
+  postgres:
+    image: postgis/postgis:16-3.4
+    volumes:
+      - postgres_data:/var/lib/postgresql/data
+
+  redis:
+    image: redis:7-alpine
+    volumes:
+      - redis_data:/data
+
+  minio:
+    image: minio/minio:latest
+    command: server /data --console-address ":9001"
+    volumes:
+      - minio_data:/data
+
+volumes:
+  postgres_data:
+  redis_data:
+  minio_data:
+```
+
