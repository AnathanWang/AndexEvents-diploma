+
+// UpdateSupabaseUID обновляет supabaseUid у существующего пользователя
+func (r *userRepository) UpdateSupabaseUID(ctx context.Context, id, supabaseUID string) (*model.User, error) {
+	query := `
+		UPDATE "User"
