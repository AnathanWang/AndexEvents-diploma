--- /dev/null
+++ b/services-java/mvnw
@@ -0,0 +1,37 @@
+#!/bin/sh
+# Maven Wrapper script
+
+set -euf
+
+BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
+WRAPPER_DIR="$BASE_DIR/.mvn/wrapper"
+PROPS_FILE="$WRAPPER_DIR/maven-wrapper.properties"
+JAR_FILE="$WRAPPER_DIR/maven-wrapper.jar"
+
+if [ ! -f "$PROPS_FILE" ]; then
+  echo "Missing $PROPS_FILE" >&2
+  exit 1
+fi
+
+if [ ! -f "$JAR_FILE" ]; then
+  WRAPPER_URL=$(grep -E '^wrapperUrl=' "$PROPS_FILE" | sed -e 's/^wrapperUrl=//')
+  if [ -z "${WRAPPER_URL:-}" ]; then
+    echo "wrapperUrl not set in $PROPS_FILE" >&2
+    exit 1
+  fi
+  echo "Downloading Maven Wrapper JAR..." >&2
+  mkdir -p "$WRAPPER_DIR"
+  if command -v curl >/dev/null 2>&1; then
+    curl -sSL -o "$JAR_FILE" "$WRAPPER_URL"
+  elif command -v wget >/dev/null 2>&1; then
+    wget -q -O "$JAR_FILE" "$WRAPPER_URL"
+  else
+    echo "Neither curl nor wget found; cannot download Maven Wrapper" >&2
+    exit 1
+  fi
+fi
+
+JAVA_CMD=${JAVA_HOME:+"$JAVA_HOME/bin/java"}
+JAVA_CMD=${JAVA_CMD:-java}
+
+exec "$JAVA_CMD" -classpath "$JAR_FILE" -Dmaven.multiModuleProjectDirectory="$BASE_DIR" org.apache.maven.wrapper.MavenWrapperMain "$@"
diff --git a/services-java/mvnw.cmd b/services-java/mvnw.cmd
new file mode 100644
index 0000000..a1f9d29
--- /dev/null
+++ b/services-java/mvnw.cmd
@@ -0,0 +1,31 @@
+@echo off
+setlocal
+set BASE_DIR=%~dp0
+set WRAPPER_DIR=%BASE_DIR%\.mvn\wrapper
+set PROPS_FILE=%WRAPPER_DIR%\maven-wrapper.properties
+set JAR_FILE=%WRAPPER_DIR%\maven-wrapper.jar
+
+if not exist "%PROPS_FILE%" (
+  echo Missing %PROPS_FILE%
+  exit /b 1
+)
+
+if not exist "%JAR_FILE%" (
+  for /f "usebackq tokens=1,* delims==" %%A in ("%PROPS_FILE%") do (
+    if "%%A"=="wrapperUrl" set WRAPPER_URL=%%B
+  )
+  if "%WRAPPER_URL%"=="" (
+    echo wrapperUrl not set in %PROPS_FILE%
+    exit /b 1
+  )
+  echo Downloading Maven Wrapper JAR...
+  powershell -NoProfile -ExecutionPolicy Bypass -Command "(New-Object Net.WebClient).DownloadFile('%WRAPPER_URL%','%JAR_FILE%')" || exit /b 1
+)
+
+if defined JAVA_HOME (
+  set JAVA_CMD=%JAVA_HOME%\bin\java
+) else (
+  set JAVA_CMD=java
+)
+
+"%JAVA_CMD%" -classpath "%JAR_FILE%" -Dmaven.multiModuleProjectDirectory="%BASE_DIR%" org.apache.maven.wrapper.MavenWrapperMain %*
