+  String get toBackendValue {
+    switch (this) {
+      case ReportReason.spam:
+        return 'SPAM';
+      case ReportReason.inappropriateContent:
+        return 'INAPPROPRIATE_CONTENT';
+      case ReportReason.harassment:
+        return 'HARASSMENT';
